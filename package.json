{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prod": "vite build --mode production",
        "start": "serve ./build_production",
        "pm2:start": "pm2 start 'serve ./build_production' --name velar-docs",
        "pm2:refresh": "pnpm run prod && pm2 reload velar-docs",
        "pm2:stop": "pm2 stop velar-docs",
        "pm2:delete": "pm2 delete velar-docs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.8",
        "@tighten/jigsaw-vite-plugin": "^1.0.0",
        "tailwindcss": "^4.1.11",
        "vite": "^6.4.1"
    },
    "dependencies": {
        "@docsearch/core": "^4.6.0",
        "@docsearch/css": "^4.6.0",
        "@docsearch/js": "^4.6.0",
        "@docsearch/modal": "^4.6.0",
        "@fontsource/geist": "^5.2.8",
        "@fontsource/geist-mono": "^5.2.7",
        "@fontsource/instrument-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/raleway": "^5.2.8",
        "@tailwindcss/typography": "^0.5.19",
        "alpinejs": "^3.15.8",
        "prismjs": "^1.30.0",
        "serve": "^14.2.6",
        "shadcn": "^3.8.5",
        "tw-animate-css": "^1.4.0"
    }
}
